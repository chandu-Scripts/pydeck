<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a1929"/>
      <stop offset="100%" style="stop-color:#1a2440"/>
    </linearGradient>
    <linearGradient id="card" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#22d3ee"/>
      <stop offset="100%" style="stop-color:#06b6d4"/>
    </linearGradient>
    <linearGradient id="py" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6"/>
      <stop offset="50%" style="stop-color:#8b5cf6"/>
      <stop offset="100%" style="stop-color:#22d3ee"/>
    </linearGradient>
  </defs>

  <!-- Background with rounded corners -->
  <rect width="512" height="512" rx="108" fill="url(#bg)"/>

  <!-- Glow effect -->
  <circle cx="256" cy="256" r="200" fill="#22d3ee" opacity="0.15"/>
  <circle cx="256" cy="256" r="150" fill="#22d3ee" opacity="0.1"/>

  <!-- Main card stack -->
  <!-- Back cards -->
  <rect x="90" y="150" width="332" height="220" rx="24" fill="#0f1629" opacity="0.3" transform="rotate(-5 256 260)"/>
  <rect x="90" y="150" width="332" height="220" rx="24" fill="#151d35" opacity="0.5" transform="rotate(-2.5 256 260)"/>

  <!-- Front card -->
  <rect x="90" y="150" width="332" height="220" rx="24" fill="url(#card)" stroke="#22d3ee" stroke-width="4"/>
  <rect x="102" y="162" width="308" height="196" rx="18" fill="#060a13" opacity="0.9"/>

  <!-- Python logo simplified -->
  <g transform="translate(256, 260)">
    <!-- Top part (blue) -->
    <path d="M -45,-35 Q -45,-55 -25,-55 L 15,-55 Q 35,-55 35,-35 L 35,0 Q 35,15 20,15 L -20,15 Q -35,15 -35,0 Z"
          fill="url(#py)" opacity="0.95"/>
    <circle cx="-25" cy="-42" r="5" fill="#ffffff"/>

    <!-- Bottom part (cyan) -->
    <path d="M 45,35 Q 45,55 25,55 L -15,55 Q -35,55 -35,35 L -35,0 Q -35,-15 -20,-15 L 20,-15 Q 35,-15 35,0 Z"
          fill="#22d3ee" opacity="0.95"/>
    <circle cx="25" cy="42" r="5" fill="#0a1929"/>

    <!-- Center connecting piece -->
    <rect x="-5" y="-10" width="10" height="20" fill="#1a2440" opacity="0.6" rx="2"/>
  </g>

  <!-- "Py" text on card -->
  <text x="256" y="400" font-family="'Inter', Arial, sans-serif" font-size="72" font-weight="900"
        fill="#22d3ee" text-anchor="middle" letter-spacing="-2">
    Py
  </text>
</svg>
